---
import Layout from '../../layouts/Layout.astro';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { FloatingWhatsApp } from '../../components/FloatingWhatsApp';
import { INVITATION_TEMPLATES, WHATSAPP_NUMBER, BRAND_NAME } from '../../data/weddingData';
import type { InvitationTemplate } from '../../types/wedding';
import { ParchmentLogo } from '../../components/ParchmentLogo';
import {
  ArrowLeft,
  Sparkles,
  Check,
  MapPin,
  Clock,
  Music,
  Calendar,
  Heart,
  ShieldCheck,
} from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa6';

export function getStaticPaths() {
  return INVITATION_TEMPLATES.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

interface Props {
  template: InvitationTemplate;
}

const { template } = Astro.props;

const whatsappOrderUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  `¡Hola ${BRAND_NAME}! Estoy viendo la ficha completa del diseño "${template.name}" y me gustaría reservarlo para nuestra boda.`
)}`;

const otherTemplates = INVITATION_TEMPLATES.filter((t) => t.id !== template.id).slice(0, 3);
---

<Layout
  title={`Diseño ${template.name} — ${BRAND_NAME} Invitaciones de Boda`}
  description={template.description}
>
  <Navbar client:load />

  <main class="pt-28 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Back Link -->
      <div class="mb-8">
        <a
          href="/#catalogo"
          class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-charcoal-muted hover:text-gold-dark transition"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Volver al Catálogo de Diseños</span>
        </a>
      </div>

      <!-- Product Showcase Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <!-- Left Column: Visual Live Invitation Card Mockup -->
        <div class="lg:col-span-7 space-y-6">
          <div
            class="border border-gold/40 shadow-editorial-lg overflow-hidden p-5 sm:p-8"
            style={`background-color: ${template.palette.bgHex};`}
          >
            <div class="relative h-80 sm:h-96 overflow-hidden border border-gold/30">
              <img
                src={template.coverImage}
                alt={`Diseño de invitación ${template.name}`}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-charcoal/85 via-charcoal/25 to-transparent" />

              <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                <span class="px-3 py-1 bg-ivory-50/90 text-[10px] uppercase tracking-[0.2em] text-charcoal">
                  Vista Previa Editorial
                </span>
                <span class="px-3 py-1 bg-gold text-ivory-50 text-[10px] uppercase tracking-[0.2em] flex items-center gap-1.5">
                  <ParchmentLogo className="w-3.5 h-3.5" />
                  {template.category}
                </span>
              </div>

              <div class="absolute bottom-6 inset-x-6 text-center text-ivory-50">
                <p class="text-[11px] uppercase tracking-[0.3em] text-champagne">
                  {template.coupleDemo.displayDate}
                </p>
                <h2 class="font-serif text-4xl sm:text-5xl mt-1">
                  {template.coupleDemo.bride} <span class="italic text-gold-light">&amp;</span>{' '}
                  {template.coupleDemo.groom}
                </h2>
                <p class="text-xs uppercase tracking-[0.2em] text-ivory-200 mt-1">
                  {template.coupleDemo.city}
                </p>
              </div>
            </div>

            <!-- Simulated Invitation Sections Below Hero Image -->
            <div class="mt-6 space-y-5 text-center">
              <div
                class="p-5 border border-gold/25"
                style={`background-color: ${template.palette.cardHex};`}
              >
                <p class="font-serif italic text-xl text-charcoal">
                  {template.coupleDemo.quote}
                </p>
                <div class="mt-3 pt-3 border-t border-charcoal/10 flex items-center justify-center gap-2 text-xs text-charcoal-muted">
                  <Music className="w-4 h-4 text-gold-dark" />
                  <span>
                    Melodía sugerida: <strong>{template.coupleDemo.songTitle}</strong> ·{' '}
                    {template.coupleDemo.songArtist}
                  </span>
                </div>
              </div>

              <!-- Ceremony & Reception Cards -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
                <div class="p-5 bg-ivory-50 border border-ivory-300">
                  <span class="text-[10px] uppercase tracking-[0.2em] text-gold-dark font-semibold">
                    Ceremonia Religiosa / Civil
                  </span>
                  <h3 class="font-serif text-xl text-charcoal mt-1">
                    {template.coupleDemo.ceremonyVenue}
                  </h3>
                  <p class="text-xs text-charcoal-muted mt-2 flex items-center gap-1.5">
                    <Clock className="w-3.5 h-3.5 text-sage" />
                    <span>{template.coupleDemo.ceremonyTime}</span>
                  </p>
                  <p class="text-xs text-charcoal-muted mt-1 flex items-center gap-1.5">
                    <MapPin className="w-3.5 h-3.5 text-sage" />
                    <span>{template.coupleDemo.city}</span>
                  </p>
                </div>

                <div class="p-5 bg-ivory-50 border border-ivory-300">
                  <span class="text-[10px] uppercase tracking-[0.2em] text-gold-dark font-semibold">
                    Recepción &amp; Banquete
                  </span>
                  <h3 class="font-serif text-xl text-charcoal mt-1">
                    {template.coupleDemo.receptionVenue}
                  </h3>
                  <p class="text-xs text-charcoal-muted mt-2 flex items-center gap-1.5">
                    <Clock className="w-3.5 h-3.5 text-sage" />
                    <span>{template.coupleDemo.receptionTime}</span>
                  </p>
                  <p class="text-xs text-charcoal-muted mt-1 flex items-center gap-1.5">
                    <Calendar className="w-3.5 h-3.5 text-sage" />
                    <span>{template.coupleDemo.dressCode.split('·')[0]}</span>
                  </p>
                </div>
              </div>

              <!-- Itinerary Preview -->
              <div class="p-5 bg-ivory-50 border border-ivory-300 text-left">
                <span class="text-[10px] uppercase tracking-[0.22em] text-gold-dark font-semibold block mb-3">
                  Programa del Evento Incluido
                </span>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {
                    template.itinerary.map((ev) => (
                      <div class="p-3 bg-ivory-100 border border-ivory-200 flex items-center justify-between">
                        <div>
                          <p class="font-serif text-base font-medium text-charcoal">{ev.title}</p>
                          <p class="text-[11px] text-charcoal-muted">{ev.location}</p>
                        </div>
                        <span class="text-xs font-semibold text-gold-dark">{ev.time}</span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Purchase Details & Features -->
        <div class="lg:col-span-5 bg-ivory-50 border border-ivory-300 p-7 sm:p-9 shadow-editorial space-y-6 lg:sticky lg:top-28">
          <div>
            <span class="text-xs uppercase tracking-[0.22em] text-gold-dark font-semibold">
              {template.collection}
            </span>
            <h1 class="font-serif text-4xl sm:text-5xl text-charcoal mt-1">
              Modelo {template.name}
            </h1>

            <div class="mt-4 flex flex-wrap items-center gap-3">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-champagne border border-gold/40 text-xs font-semibold uppercase tracking-wider text-gold-dark">
                <ParchmentLogo className="w-3.5 h-3.5" />
                <span>Próximamente en CLP ($)</span>
              </span>
            </div>
          </div>

          <p class="text-sm text-charcoal-muted leading-relaxed">
            {template.description}
          </p>

          <!-- Color Palette Info -->
          <div class="p-4 bg-ivory-100 border border-ivory-300 flex items-center justify-between">
            <div>
              <span class="text-[10px] uppercase tracking-widest text-charcoal-muted block">
                Paleta Sugerida (100% Personalizable)
              </span>
              <span class="font-serif text-lg text-charcoal font-medium">
                {template.palette.name}
              </span>
            </div>
            <div class="flex items-center gap-2">
              {
                [
                  template.palette.bgHex,
                  template.palette.cardHex,
                  template.palette.accentHex,
                  template.palette.textHex,
                ].map((hex) => (
                  <span
                    class="w-6 h-6 rounded-full border border-charcoal/25"
                    style={`background-color: ${hex};`}
                  />
                ))
              }
            </div>
          </div>

          <!-- Included Features -->
          <div>
            <h2 class="text-xs uppercase tracking-[0.2em] text-charcoal font-semibold mb-3">
              Características Interactivas Incluidas:
            </h2>
            <ul class="space-y-2.5">
              {
                template.includedFeatures.map((feat) => (
                  <li class="text-xs text-charcoal-light flex items-start gap-2.5">
                    <Check className="w-4 h-4 text-gold-dark shrink-0 mt-0.5" />
                    <span>{feat}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- CTAs -->
          <div class="pt-4 border-t border-ivory-200 space-y-3">
            <a
              href={whatsappOrderUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 bg-charcoal hover:bg-gold-dark text-ivory-50 text-xs uppercase tracking-[0.2em] font-medium transition flex items-center justify-center gap-2 shadow-sm"
            >
              <FaWhatsapp className="w-4 h-4 text-[#A7D7B8]" />
              <span>Pedir Diseño «{template.name}» por WhatsApp</span>
            </a>

            <a
              href="/#catalogo"
              class="w-full py-3.5 bg-champagne hover:bg-gold hover:text-ivory-50 text-charcoal text-xs uppercase tracking-[0.18em] font-medium transition flex items-center justify-center gap-2 border border-gold/30"
            >
              <ParchmentLogo className="w-3.5 h-3.5" />
              <span>Ver Más Diseños en el Catálogo</span>
            </a>

            <p class="text-[11px] text-center text-charcoal-muted flex items-center justify-center gap-1.5 pt-1">
              <ShieldCheck className="w-4 h-4 text-sage" />
              <span>Garantía de diseño y atención personalizada</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Other Designs Section -->
      <div class="mt-20 pt-14 border-t border-ivory-300">
        <div class="flex items-center justify-between mb-8">
          <h2 class="font-serif text-3xl text-charcoal">Otros diseños que podrían enamorarte</h2>
          <a
            href="/#catalogo"
            class="text-xs uppercase tracking-[0.18em] text-gold-dark hover:underline"
          >
            Ver todos los diseños →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            otherTemplates.map((item) => (
              <a
                href={`/disenos/${item.slug}`}
                class="editorial-card p-4 flex items-center gap-4 group"
              >
                <img
                  src={item.coverImage}
                  alt={item.name}
                  class="w-20 h-24 object-cover shrink-0"
                  loading="lazy"
                />
                <div>
                  <span class="text-[10px] uppercase tracking-widest text-gold-dark">
                    {item.category}
                  </span>
                  <h3 class="font-serif text-2xl text-charcoal group-hover:text-gold-dark transition">
                    {item.name}
                  </h3>
                  <p class="text-xs text-charcoal-muted mt-0.5">Próximamente en CLP ($) · Envíos Ilimitados</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <FloatingWhatsApp />
  <Footer />
</Layout>
