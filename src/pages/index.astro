---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { CatalogExplorer } from "../components/CatalogExplorer";
import { FaqAccordion } from "../components/FaqAccordion";
import { FloatingWhatsApp } from "../components/FloatingWhatsApp";
import { Footer } from "../components/Footer";
import { BRAND_NAME, WHATSAPP_NUMBER } from "../data/siteConfig";
import { ParchmentLogo } from "../components/ParchmentLogo";
import {
  Heart,
  Mail,
  Music,
  MapPin,
  Clock,
  HelpCircle,
  CheckCircle2,
} from "lucide-react";
import { FaWhatsapp } from "react-icons/fa6";

const whatsappHeroUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  `¡Hola ${BRAND_NAME}! Quiero recibir información para crear la invitación digital de nuestra boda.`,
)}`;

const heartPath800 =
  "M 400 156 C 440 72, 512 40, 592 40 C 696 40, 768 128, 768 252 C 768 456, 576 624, 400 748 C 224 624, 32 456, 32 252 C 32 128, 104 40, 208 40 C 288 40, 360 72, 400 156 Z";

const heartPathNormalized =
  "M 0.5 0.195 C 0.55 0.09, 0.64 0.05, 0.74 0.05 C 0.87 0.05, 0.96 0.16, 0.96 0.315 C 0.96 0.57, 0.72 0.78, 0.5 0.935 C 0.28 0.78, 0.04 0.57, 0.04 0.315 C 0.04 0.16, 0.13 0.05, 0.26 0.05 C 0.36 0.05, 0.45 0.09, 0.5 0.195 Z";
---

<Layout preloadHeroImage="/images/hero-corazon.jpg">
  <!-- Navigation Bar -->
  <Navbar client:load />

  <main class="pt-20 sm:pt-24 overflow-hidden">
    <!-- ========================================== -->
    <!-- HERO SECTION -->
    <!-- ========================================== -->
    <section
      class="relative py-12 sm:py-16 lg:py-20 bg-ivory-100/90 border-b border-ivory-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-10 items-center"
        >
          <!-- Left Editorial Copy -->
          <div
            id="hero-editorial-copy"
            class="lg:col-span-7 space-y-6 text-center lg:text-left"
          >
            <h1
              class="font-serif text-4xl sm:text-6xl lg:text-[66px] text-charcoal leading-[1.06] font-medium tracking-tight reveal-delicate delay-1"
            >
              Invitaciones<span class="italic text-gold-dark font-medium">
                digitales de boda</span
              >
            </h1>

            <p
              class="text-sm sm:text-base text-charcoal-light leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal reveal-delicate delay-2"
            >
              "Sorprende a tus invitados desde el primer instante con una
              hermosa invitación digital. Ellos recibiran un 'sobre' que al
              tocarlo se abrirá ¡Y verán algo que no olvidarán!
            </p>

            <!-- Hero CTAs: Botones principales y Asesoría en WhatsApp -->
            <div
              class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3.5 reveal-delicate delay-3"
            >
              <a
                href={whatsappHeroUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-gold w-full sm:w-auto shadow-sm"
              >
                <FaWhatsapp className="w-4 h-4 text-[#A7D7B8]" />
                <span>Asesoría en WhatsApp</span>
              </a>

              <a
                href="#catalogo"
                class="btn-outline-editorial w-full sm:w-auto"
              >
                <ParchmentLogo className="w-4 h-4" />
                <span>Explorar Catálogo</span>
              </a>
            </div>

            <!-- Botones del Navbar en el Hero (Visible exclusivamente en celular, ocultos en computador) -->
            <div
              class="pt-5 border-t border-ivory-300 mt-4 reveal-delicate delay-4 block md:hidden"
            >
              <p
                class="text-[11px] uppercase tracking-[0.22em] text-charcoal font-semibold mb-2.5 text-center"
              >
                Accesos directos del menú:
              </p>
              <div class="grid grid-cols-3 gap-2 max-w-lg mx-auto">
                <a
                  href="#catalogo"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-white border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-colors text-xs uppercase tracking-wider text-charcoal font-semibold shadow-xs"
                >
                  <ParchmentLogo className="w-3.5 h-3.5 shrink-0" />
                  <span>Catálogo</span>
                </a>
                <a
                  href="#funciones"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-white border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-colors text-xs uppercase tracking-wider text-charcoal font-semibold shadow-xs"
                >
                  <CheckCircle2
                    className="w-3.5 h-3.5 text-sage-dark shrink-0"
                  />
                  <span>Funciones</span>
                </a>
                <a
                  href="#preguntas"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-white border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-colors text-xs uppercase tracking-wider text-charcoal font-semibold shadow-xs"
                >
                  <HelpCircle className="w-3.5 h-3.5 text-gold-dark shrink-0" />
                  <span>Preguntas</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Right Editorial Heart Portrait -->
          <div
            class="lg:col-span-5 flex items-center justify-center reveal-delicate delay-4"
            id="hero-corazon"
          >
            <div
              class="relative w-full max-w-[310px] sm:max-w-[370px] lg:max-w-[420px] aspect-square animate-lightbounce group drop-shadow-[0_24px_38px_rgba(34,31,29,0.13)]"
            >
              <div
                class="w-full h-full overflow-hidden"
                style="-webkit-clip-path: url(#hero-heart-clip); clip-path: url(#hero-heart-clip);"
              >
                <picture class="block w-full h-full">
                  <img
                    src="/images/hero-corazon.jpg"
                    alt="Manos entrelazadas con anillo de compromiso"
                    width="900"
                    height="900"
                    fetchpriority="high"
                    decoding="async"
                    class="w-full h-full object-cover object-center transition-transform duration-1000 ease-out group-hover:scale-105"
                  />
                </picture>
              </div>

              <svg
                viewBox="0 0 800 800"
                class="pointer-events-none absolute inset-0 w-full h-full overflow-visible"
                aria-hidden="true"
              >
                <defs>
                  <clipPath
                    id="hero-heart-clip"
                    clipPathUnits="objectBoundingBox"
                  >
                    <path d={heartPathNormalized}></path>
                  </clipPath>
                  <linearGradient
                    id="hero-heart-gold"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="100%"
                  >
                    <stop offset="0%" stop-color="#D4BC91"></stop>
                    <stop offset="50%" stop-color="#B5945B"></stop>
                    <stop offset="100%" stop-color="#DFD2BE"></stop>
                  </linearGradient>
                </defs>

                <!-- Sutil halo exterior estilo alta costura -->
                <g
                  transform="translate(400, 394) scale(1.038) translate(-400, -394)"
                >
                  <path
                    d={heartPath800}
                    fill="none"
                    stroke="#C8B289"
                    stroke-opacity="0.55"
                    stroke-width="2"></path>
                </g>

                <!-- Contorno dorado champán que envuelve el corazón -->
                <path
                  d={heartPath800}
                  fill="none"
                  stroke="url(#hero-heart-gold)"
                  stroke-width="4.5"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- CATÁLOGO DE DISEÑOS -->
    <!-- ========================================== -->
    <section
      id="catalogo"
      class="relative py-20 sm:py-32 bg-[#FCFAF7] border-b border-ivory-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3.5">
          <h2
            class="scroll-reveal font-serif text-4xl sm:text-5xl lg:text-[56px] text-charcoal font-medium tracking-tight leading-[1.12]"
            style="--reveal-delay: 0.14s"
          >
            Elige el escenario digital <span
              class="italic text-gold-dark font-medium">de tu historia</span
            >
          </h2>

          <div
            class="scroll-reveal w-12 h-[2px] bg-gold-dark/60 mx-auto rounded-full my-1"
            style="--reveal-delay: 0.20s"
          >
          </div>

          <p
            class="scroll-reveal text-sm sm:text-base text-charcoal-light leading-relaxed font-normal max-w-3xl mx-auto"
            style="--reveal-delay: 0.26s"
          >
            Cada diseño es 100% personalizable. Toda idea e imaginación es
            bienvenida y realizable mientras sea técnicamente posible en el
            código.
          </p>
        </div>

        <CatalogExplorer client:load />
      </div>
    </section>

    <!-- ========================================== -->
    <!-- EXPERIENCIA DIGITAL & FUNCIONES -->
    <!-- ========================================== -->
    <section
      id="funciones"
      class="py-20 sm:py-28 bg-[#F4EDE2] border-y border-ivory-300 relative shadow-inner"
    >
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-10"
      >
        <div class="space-y-3.5 max-w-3xl mx-auto">
          <h2
            class="scroll-reveal font-serif text-3xl sm:text-5xl lg:text-[52px] text-charcoal font-medium tracking-tight leading-[1.14]"
            style="--reveal-delay: 0.14s"
          >
            Recibe funciones especiales <span
              class="italic text-gold-dark font-medium">en una sola página</span
            >
          </h2>

          <div
            class="scroll-reveal w-12 h-[2px] bg-sage/60 mx-auto rounded-full my-1"
            style="--reveal-delay: 0.20s"
          >
          </div>

          <p
            class="scroll-reveal text-sm sm:text-base text-charcoal-light leading-relaxed font-normal max-w-2xl mx-auto"
            style="--reveal-delay: 0.30s"
          >
            Tus seres queridos solo tocan el enlace y tienen toda la información
            de la boda a mano, con navegación fluida y pensada para todas las
            edades.
          </p>
        </div>

        <ul
          class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4"
        >
          {
            [
              {
                icon: Mail,
                label: "Sobre animado",
                desc: "Apertura con música",
              },
              { icon: Music, label: "Su canción", desc: "Melodía de fondo" },
              { icon: MapPin, label: "Ubicación", desc: "Google Maps y Waze" },
              {
                icon: Clock,
                label: "Cuenta regresiva",
                desc: "Tiempo en vivo",
              },
              {
                icon: FaWhatsapp,
                label: "Confirmación",
                desc: "Directa a WhatsApp",
              },
              {
                icon: Heart,
                label: "Diseño a Medida",
                desc: "Atención artesanal",
              },
            ].map(({ icon: Icon, label, desc }, idx) => (
              <li
                class="scroll-reveal flex flex-col items-center gap-2 p-4 sm:p-5 bg-white border border-ivory-300 shadow-xs hover:border-gold/60 hover:shadow-editorial transition-[border-color,box-shadow] duration-300 group"
                style={`--reveal-delay: ${(idx * 0.08).toFixed(2)}s`}
              >
                <span class="w-11 h-11 rounded-full bg-champagne group-hover:bg-gold group-hover:text-ivory-50 transition-colors flex items-center justify-center text-gold-dark shrink-0">
                  <Icon className="w-5 h-5" />
                </span>
                <span class="text-xs uppercase tracking-wider text-charcoal font-semibold">
                  {label}
                </span>
                <span class="text-[11px] text-charcoal-light font-medium">
                  {desc}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PREGUNTAS FRECUENTES -->
    <!-- ========================================== -->
    <section
      id="preguntas"
      class="py-20 sm:py-32 bg-ivory-100/70 border-b border-ivory-300 relative"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3.5">
          <div
            class="scroll-reveal inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-champagne border border-gold/50 text-[11px] uppercase tracking-[0.24em] text-gold-dark font-bold"
            style="--reveal-delay: 0.05s"
          >
            <HelpCircle className="w-3.5 h-3.5" />
            <span>Preguntas Frecuentes</span>
          </div>

          <h2
            class="scroll-reveal font-serif text-4xl sm:text-5xl lg:text-[54px] text-charcoal font-medium tracking-tight leading-[1.12]"
            style="--reveal-delay: 0.14s"
          >
            Preguntas <span class="italic text-gold-dark font-medium"
              >Frecuentes</span
            >
          </h2>

          <div
            class="scroll-reveal w-12 h-[2px] bg-gold-dark/60 mx-auto rounded-full my-1"
            style="--reveal-delay: 0.20s"
          >
          </div>

          <p
            class="scroll-reveal text-xs sm:text-sm uppercase tracking-[0.18em] text-gold-dark font-semibold"
            style="--reveal-delay: 0.24s"
          >
            Claridad total para cada paso de su invitación de boda
          </p>

          <p
            class="scroll-reveal text-sm sm:text-base text-charcoal-light leading-relaxed font-normal max-w-2xl mx-auto"
            style="--reveal-delay: 0.30s"
          >
            Todo lo que necesitas saber sobre tiempos de entrega,
            personalización de canciones y fotografías, y confirmaciones
            automáticas vía WhatsApp.
          </p>
        </div>

        <div class="scroll-reveal" style="--reveal-delay: 0.18s">
          <FaqAccordion client:visible />
        </div>
      </div>
    </section>
  </main>

  <!-- Floating WhatsApp Concierge -->
  <FloatingWhatsApp />

  <!-- Footer -->
  <Footer />
</Layout>
