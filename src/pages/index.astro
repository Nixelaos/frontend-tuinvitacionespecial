---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { HeroRealInvitation } from '../components/HeroRealInvitation';
import { CatalogExplorer } from '../components/CatalogExplorer';
import { FaqAccordion } from '../components/FaqAccordion';
import { FloatingWhatsApp } from '../components/FloatingWhatsApp';
import { Footer } from '../components/Footer';
import { BRAND_NAME, WHATSAPP_NUMBER } from '../data/weddingData';
import { ParchmentLogo } from '../components/ParchmentLogo';
import {
  Sparkles,
  ArrowRight,
  Heart,
  Mail,
  Music,
  MapPin,
  Clock,
  HelpCircle,
  CheckCircle2,
} from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa6';

const whatsappHeroUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  `¡Hola ${BRAND_NAME}! Quiero recibir información para crear la invitación digital de nuestra boda.`
)}`;
---

<Layout>
  <!-- Navigation Bar -->
  <Navbar client:load />

  <main class="pt-20 sm:pt-24 overflow-hidden">
    <!-- ========================================== -->
    <!-- HERO SECTION -->
    <!-- ========================================== -->
    <section class="relative py-12 sm:py-16 lg:py-16 bg-ivory-100/90 border-b border-ivory-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <!-- Left Editorial Copy -->
          <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
            <h1 class="font-serif text-4xl sm:text-6xl lg:text-[66px] text-charcoal leading-[1.06] font-normal tracking-tight">
              Invitaciones digitales de boda <span class="italic text-gold-dark font-medium">hermosas e inolvidables</span>
            </h1>

            <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed max-w-2xl mx-auto lg:mx-0 font-light">
              "Sorprende a tus invitados desde el primer instante con un hermoso sobre interactivo que se abre al tocarlo..."
            </p>

            <!-- Hero CTAs: Botones principales y Asesoría en WhatsApp -->
            <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3.5">
              <a
                href={whatsappHeroUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-gold w-full sm:w-auto shadow-sm"
              >
                <FaWhatsapp className="w-4 h-4 text-[#A7D7B8]" />
                <span>Asesoría en WhatsApp</span>
              </a>

              <a href="#catalogo" class="btn-outline-editorial w-full sm:w-auto">
                <ParchmentLogo className="w-4 h-4 text-gold-dark" />
                <span>Explorar Catálogo</span>
              </a>
            </div>

            <!-- Botones del Navbar en el Hero (Especialmente visible y optimizado para celular) -->
            <div class="pt-5 border-t border-ivory-300/80 mt-4">
              <p class="text-[10px] sm:text-[11px] uppercase tracking-[0.24em] text-charcoal-muted font-semibold mb-2.5 text-center lg:text-left">
                Accesos directos del menú:
              </p>
              <div class="grid grid-cols-3 gap-2 max-w-lg mx-auto lg:mx-0">
                <a
                  href="#catalogo"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-ivory-50/95 border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-all text-[11px] uppercase tracking-wider text-charcoal font-medium shadow-xs"
                >
                  <ParchmentLogo className="w-3.5 h-3.5 text-gold-dark shrink-0" />
                  <span>Catálogo</span>
                </a>
                <a
                  href="#funciones"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-ivory-50/95 border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-all text-[11px] uppercase tracking-wider text-charcoal font-medium shadow-xs"
                >
                  <CheckCircle2 className="w-3.5 h-3.5 text-sage-dark shrink-0" />
                  <span>Funciones</span>
                </a>
                <a
                  href="#preguntas"
                  class="flex items-center justify-center gap-1.5 py-2.5 px-3 bg-ivory-50/95 border border-ivory-300 hover:border-gold hover:bg-champagne/40 transition-all text-[11px] uppercase tracking-wider text-charcoal font-medium shadow-xs"
                >
                  <HelpCircle className="w-3.5 h-3.5 text-gold-dark shrink-0" />
                  <span>Preguntas</span>
                </a>
              </div>
            </div>
          </div>

          <!-- Right Real Interactive Invitation Preview -->
          <div class="lg:col-span-5" id="hero-simulador">
            <HeroRealInvitation client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- CATÁLOGO DE DISEÑOS -->
    <!-- ========================================== -->
    <section id="catalogo" class="relative py-20 sm:py-32 bg-[#FCFAF7] border-b border-ivory-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3.5">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-champagne/80 border border-gold/40 text-[11px] uppercase tracking-[0.28em] text-gold-dark font-semibold shadow-xs">
            <ParchmentLogo className="w-3.5 h-3.5 text-gold-dark" />
            <span>Catálogo de Diseños Exclusivos</span>
          </div>

          <h2 class="font-serif text-4xl sm:text-5xl lg:text-[56px] text-charcoal font-normal tracking-tight leading-[1.12]">
            Elige el escenario digital <span class="italic text-gold-dark font-normal">de tu historia</span>
          </h2>

          <div class="w-12 h-[2px] bg-gold/50 mx-auto rounded-full my-1"></div>


          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed font-light max-w-3xl mx-auto">
            Cada diseño es 100% personalizable y completamente modificable: adaptamos las fotografías, paleta de colores, música, secciones y detalles según el gusto y estilo de cada pareja. Toda idea e imaginación es bienvenida y realizable mientras sea técnicamente posible en código. Explora los modelos para vivir la experiencia interactiva en tiempo real.
          </p>
        </div>

        <CatalogExplorer client:load />
      </div>
    </section>

    <!-- ========================================== -->
    <!-- EXPERIENCIA DIGITAL & FUNCIONES -->
    <!-- ========================================== -->
    <section id="funciones" class="py-20 sm:py-28 bg-[#F4EDE2] border-y border-ivory-300 relative shadow-inner">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-10">
        <div class="space-y-3.5 max-w-3xl mx-auto">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-ivory-50 border border-sage/40 text-[11px] uppercase tracking-[0.28em] text-sage-dark font-semibold shadow-xs">
            <span>Experiencia Digital Personalizada</span>
          </div>

          <h2 class="font-serif text-3xl sm:text-5xl lg:text-[52px] text-charcoal font-normal tracking-tight leading-[1.14]">
            Todo lo que tus invitados necesitan, <span class="italic text-gold-dark font-normal">en un solo enlace</span>
          </h2>

          <div class="w-12 h-[2px] bg-sage/40 mx-auto rounded-full my-1"></div>

          <p class="text-xs sm:text-sm uppercase tracking-[0.18em] text-charcoal-muted font-medium">
            Sin descargar aplicaciones ni registros: directo desde WhatsApp
          </p>

          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed font-light max-w-2xl mx-auto">
            Tus seres queridos solo tocan el enlace y tienen toda la información de la boda a mano, con navegación fluida y pensada para todas las edades.
          </p>
        </div>

        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3.5 sm:gap-4">
          {
            [
              { icon: Mail, label: 'Sobre animado', desc: 'Apertura con música' },
              { icon: Music, label: 'Su canción', desc: 'Melodía de fondo' },
              { icon: MapPin, label: 'Ubicación', desc: 'Google Maps y Waze' },
              { icon: Clock, label: 'Cuenta regresiva', desc: 'Tiempo en vivo' },
              { icon: FaWhatsapp, label: 'Confirmación', desc: 'Directa a WhatsApp' },
              { icon: Heart, label: 'Diseño a Medida', desc: 'Atención artesanal' },
            ].map(({ icon: Icon, label, desc }) => (
              <li class="flex flex-col items-center gap-2 p-4 sm:p-5 bg-ivory-50 border border-ivory-300/80 shadow-xs hover:border-gold/60 hover:shadow-editorial transition-all group">
                <span class="w-11 h-11 rounded-full bg-champagne group-hover:bg-gold group-hover:text-ivory-50 transition-colors flex items-center justify-center text-gold-dark shrink-0">
                  <Icon className="w-5 h-5" />
                </span>
                <span class="text-xs uppercase tracking-wider text-charcoal font-semibold">{label}</span>
                <span class="text-[11px] text-charcoal-muted font-light">{desc}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ========================================== -->
    <!-- PREGUNTAS FRECUENTES -->
    <!-- ========================================== -->
    <section id="preguntas" class="py-20 sm:py-32 bg-ivory-100/70 border-b border-ivory-300 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-14 space-y-3.5">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-champagne/80 border border-gold/40 text-[11px] uppercase tracking-[0.28em] text-gold-dark font-semibold">
            <HelpCircle className="w-3.5 h-3.5" />
            <span>Preguntas Frecuentes</span>
          </div>

          <h2 class="font-serif text-4xl sm:text-5xl lg:text-[54px] text-charcoal font-normal tracking-tight leading-[1.12]">
            Preguntas <span class="italic text-gold-dark font-normal">Frecuentes</span>
          </h2>

          <div class="w-12 h-[2px] bg-gold/50 mx-auto rounded-full my-1"></div>

          <p class="text-xs sm:text-sm uppercase tracking-[0.18em] text-gold-dark font-medium">
            Claridad total para cada paso de su invitación de boda
          </p>

          <p class="text-sm sm:text-base text-charcoal-muted leading-relaxed font-light max-w-2xl mx-auto">
            Todo lo que necesitas saber sobre tiempos de entrega, personalización de canciones y fotografías, y confirmaciones automáticas vía WhatsApp.
          </p>
        </div>

        <FaqAccordion client:visible />
      </div>
    </section>
  </main>

  <!-- Floating WhatsApp Concierge -->
  <FloatingWhatsApp />

  <!-- Footer -->
  <Footer />
</Layout>
