---
import '../styles/global.css';
import { BRAND_NAME } from '../data/weddingData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${BRAND_NAME} — Invitaciones Digitales de Boda de Alta Costura`,
  description = 'Diseño de invitaciones digitales interactivas para bodas con apertura de sobre animado, música, cuenta regresiva, mapas GPS y confirmación de asistencia directa a WhatsApp.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Cormorant Garamond, Great Vibes, Dancing Script & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Dancing+Script:wght@500;700&family=Great+Vibes&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-ivory text-charcoal antialiased selection:bg-champagne-dark selection:text-charcoal">
    <slot />
  </body>
</html>
